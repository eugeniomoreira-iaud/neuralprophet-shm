# Local working copies of any data staged here. Never committed.
.cache/

# Figures and tables regenerated by running the notebook.
outputs/

# Jupyter
.ipynb_checkpoints/
__pycache__/

# LaTeX build artefacts. The report PDF itself is tracked.
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz

# Notebook execution logs.
*.log
