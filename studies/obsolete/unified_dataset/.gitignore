# Local working copy of the raw archive. Never committed — the archive is the
# acquisition system's output and lives outside this repository.
.cache/

# Figures and tables regenerated by running the notebooks.
outputs/

# PyTorch Lightning writes training artifacts into the working directory.
lightning_logs/

# Jupyter
.ipynb_checkpoints/
__pycache__/

# LaTeX build artefacts. The report PDF itself is tracked.
report/*.aux
report/*.log
report/*.out
report/*.toc
report/build*.log

# Notebook execution and data-sync logs.
*.log
