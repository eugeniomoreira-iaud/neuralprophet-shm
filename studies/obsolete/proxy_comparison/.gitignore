# Local working copy of the raw archive, if one is ever made here. Never
# committed — the archive is the acquisition system's output and lives outside
# this repository.
.cache/

# Figures and tables regenerated by running the notebook.
outputs/

# Jupyter
.ipynb_checkpoints/
__pycache__/

# LaTeX build artefacts. The report PDF itself is tracked.
report/*.aux
report/*.log
report/*.out
report/*.toc

# Notebook execution logs.
*.log
